<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!--
      浅色主题令牌。键名与旧版 index.html 的 CSS 变量一一对应（css 的 bg 变量 → Brush.Bg，
      半透明色把 alpha 直接烘进 Color：rgba(37,99,235,0.1) → #1A2563EB）。

      换主题时本字典会被整体替换，所以界面里引用这些令牌的地方必须一律用 DynamicResource，
      用 StaticResource 换字典不会生效。CSS 里三个过渡时长变量（t-fast / t / t-slow）
      在 WPF 里由具体动画各自声明 Duration，不做成令牌。
    -->

    <SolidColorBrush x:Key="Brush.Bg" Color="#EDF1F7" />
    <SolidColorBrush x:Key="Brush.BgElev" Color="#F7F9FC" />
    <SolidColorBrush x:Key="Brush.Card" Color="#FFFFFF" />
    <SolidColorBrush x:Key="Brush.CardHover" Color="#F3F6FB" />
    <SolidColorBrush x:Key="Brush.Border" Color="#E4EAF3" />
    <SolidColorBrush x:Key="Brush.BorderStrong" Color="#D3DBE9" />
    <SolidColorBrush x:Key="Brush.Text" Color="#10141C" />
    <SolidColorBrush x:Key="Brush.TextDim" Color="#5F6980" />
    <SolidColorBrush x:Key="Brush.Accent" Color="#2563EB" />
    <SolidColorBrush x:Key="Brush.AccentHover" Color="#1D4ED8" />
    <SolidColorBrush x:Key="Brush.AccentSoft" Color="#1A2563EB" />
    <SolidColorBrush x:Key="Brush.Green" Color="#0F9D76" />
    <SolidColorBrush x:Key="Brush.Warn" Color="#B7791F" />
    <SolidColorBrush x:Key="Brush.Red" Color="#DC2626" />
    <SolidColorBrush x:Key="Brush.MarkBg" Color="#292563EB" />
    <SolidColorBrush x:Key="Brush.MarkFg" Color="#1D4ED8" />
    <SolidColorBrush x:Key="Brush.Hairline" Color="#E6FFFFFF" />

    <!-- 内容区上下边缘的渐变遮罩：从背景色淡出到透明，让标题栏 / 窗口底边不再是一条硬切线 -->
    <LinearGradientBrush x:Key="Brush.FadeTop" StartPoint="0,0" EndPoint="0,1">
        <GradientStop Offset="0" Color="#EDF1F7" />
        <GradientStop Offset="1" Color="#00EDF1F7" />
    </LinearGradientBrush>
    <LinearGradientBrush x:Key="Brush.FadeBottom" StartPoint="0,0" EndPoint="0,1">
        <GradientStop Offset="0" Color="#00EDF1F7" />
        <GradientStop Offset="1" Color="#EDF1F7" />
    </LinearGradientBrush>

    <CornerRadius x:Key="Radius">12</CornerRadius>
    <CornerRadius x:Key="RadiusSm">8</CornerRadius>

</ResourceDictionary>
