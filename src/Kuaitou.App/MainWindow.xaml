<Window x:Class="Kuaitou.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:views="clr-namespace:Kuaitou.App.Views"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        Title="快投"
        Width="950"
        Height="850"
        MinWidth="700"
        MinHeight="600"
        WindowStartupLocation="CenterScreen"
        WindowStyle="None"
        ResizeMode="CanResize"
        FontFamily="Microsoft YaHei UI, Segoe UI"
        FontSize="14"
        Background="{DynamicResource Brush.Bg}"
        Foreground="{DynamicResource Brush.Text}">

    <!--
      自绘标题栏：WindowStyle=None + WindowChrome 保留系统的拖拽 / 缩放 / 最大化行为，
      标题栏本身按主题上色（对应旧版 winbar 给原生标题栏刷 DWM 颜色的那套），
      浅色 / 深色都不显示系统图标与标题文字。
    -->
    <shell:WindowChrome.WindowChrome>
        <shell:WindowChrome CaptionHeight="0"
                            ResizeBorderThickness="6"
                            GlassFrameThickness="0"
                            CornerRadius="0"
                            UseAeroCaptionButtons="False" />
    </shell:WindowChrome.WindowChrome>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="32" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <!-- ==================== 标题栏（只占内容列，右侧放窗口按钮） ==================== -->
        <!-- 标题栏：透明，让页面内容与标题栏之间没有一条突兀的分界 -->
        <Border x:Name="TitleBar"
                Grid.Row="0"
                Grid.Column="1"
                Background="Transparent"
                MouseLeftButtonDown="OnTitleBarDrag">
            <Grid>
                <StackPanel Orientation="Horizontal"
                            HorizontalAlignment="Right"
                            VerticalAlignment="Center"
                            Margin="0,0,6,0">
                    <Button x:Name="MinButton"
                            Style="{StaticResource TitleBarButton}"
                            Click="OnMinimize"
                            AutomationProperties.Name="最小化"
                            ToolTip="最小化">
                        <Path Data="M0,6 H12"
                              Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                              StrokeThickness="1.2" />
                    </Button>
                    <Button x:Name="MaxButton"
                            Style="{StaticResource TitleBarButton}"
                            Click="OnMaximizeRestore"
                            AutomationProperties.Name="最大化"
                            ToolTip="最大化">
                        <Path x:Name="MaxIcon"
                              Data="M1,1 H11 V11 H1 Z"
                              Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                              StrokeThickness="1.2" />
                    </Button>
                    <Button x:Name="CloseButton"
                            Style="{StaticResource TitleBarCloseButton}"
                            Click="OnClose"
                            AutomationProperties.Name="关闭"
                            ToolTip="关闭">
                        <Path Data="M0,0 L11,11 M11,0 L0,11"
                              Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                              StrokeThickness="1.2" />
                    </Button>
                </StackPanel>
            </Grid>
        </Border>

        <!-- ==================== 主体：整窗高的侧边栏 + 内容 ==================== -->
        <!--
          左侧边栏：整窗高度的悬浮卡片（圆角 + 描边 + 柔和投影）。
          上下留同样的空隙，顶到窗口顶边会跟标题栏贴在一起、显得上下不对称。
          宽度由代码做动画。
        -->
        <Border x:Name="SidebarPanel"
                Grid.Row="0"
                Grid.RowSpan="2"
                Grid.Column="0"
                Width="232"
                Margin="10,12,0,12"
                Background="{DynamicResource Brush.Card}"
                BorderBrush="{DynamicResource Brush.Border}"
                BorderThickness="1"
                CornerRadius="{DynamicResource Radius}">
                <Border.Effect>
                    <DropShadowEffect BlurRadius="20"
                                      ShadowDepth="4"
                                      Direction="270"
                                      Opacity="0.12"
                                      Color="#000000" />
                </Border.Effect>
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <Grid Grid.Row="0" Margin="14,14,10,14">
                        <TextBlock x:Name="AppTitle"
                                   VerticalAlignment="Center"
                                   FontSize="22"
                                   FontWeight="Bold"
                                   Foreground="{DynamicResource Brush.Text}"
                                   Text="快投" />
                        <Button x:Name="CollapseButton"
                                HorizontalAlignment="Right"
                                VerticalAlignment="Center"
                                Width="28"
                                Height="28"
                                Style="{StaticResource TitleBarButton}"
                                Click="OnToggleSidebar"
                                AutomationProperties.Name="折叠侧边栏"
                                ToolTip="折叠侧边栏">
                            <Path x:Name="CollapseIcon"
                                  Data="M7,0 L0,6 L7,12"
                                  Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                                  StrokeThickness="1.6"
                                  StrokeStartLineCap="Round"
                                  StrokeEndLineCap="Round" />
                        </Button>
                    </Grid>

                    <!-- 设备分组：每台设备一个主页入口，点进去就是那台设备的主页 -->
                    <Grid Grid.Row="1" Margin="10,0,10,10">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>

                        <TextBlock x:Name="DeviceGroupTitle"
                                   Grid.Row="0"
                                   FontSize="11"
                                   FontWeight="SemiBold"
                                   Margin="10,6,10,6"
                                   Foreground="{DynamicResource Brush.TextDim}"
                                   Text="设备" />

                        <Grid Grid.Row="1">
                            <ListBox x:Name="DeviceList"
                                     ItemsSource="{Binding Devices.Devices}"
                                     ItemContainerStyle="{StaticResource NavDeviceItem}"
                                     SelectionChanged="OnDeviceSelected"
                                     Background="Transparent"
                                     BorderThickness="0"
                                     Padding="0"
                                     ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                     AutomationProperties.Name="设备主页入口">
                                <ListBox.ItemTemplate>
                                    <DataTemplate>
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="*" />
                                            </Grid.ColumnDefinitions>

                                            <Ellipse Grid.Column="0"
                                                     Width="8"
                                                     Height="8"
                                                     Margin="0,0,10,0"
                                                     VerticalAlignment="Center">
                                                <Ellipse.Style>
                                                    <Style TargetType="Ellipse">
                                                        <Setter Property="Fill" Value="{DynamicResource Brush.TextDim}" />
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding StateKind}" Value="online">
                                                                <Setter Property="Fill" Value="{DynamicResource Brush.Green}" />
                                                            </DataTrigger>
                                                            <DataTrigger Binding="{Binding StateKind}" Value="auth">
                                                                <Setter Property="Fill" Value="{DynamicResource Brush.Warn}" />
                                                            </DataTrigger>
                                                            <DataTrigger Binding="{Binding StateKind}" Value="offline">
                                                                <Setter Property="Fill" Value="{DynamicResource Brush.Red}" />
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </Ellipse.Style>
                                            </Ellipse>

                                            <!-- 侧边栏折叠时只留状态点 -->
                                            <StackPanel Grid.Column="1">
                                                <StackPanel.Style>
                                                    <Style TargetType="StackPanel">
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding IsSidebarCollapsed, RelativeSource={RelativeSource AncestorType=Window}}" Value="True">
                                                                <Setter Property="Visibility" Value="Collapsed" />
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </StackPanel.Style>
                                                <TextBlock FontSize="13"
                                                           TextTrimming="CharacterEllipsis"
                                                           Foreground="{DynamicResource Brush.Text}"
                                                           Text="{Binding Name}" />
                                                <TextBlock Margin="0,2,0,0"
                                                           FontSize="11"
                                                           FontFamily="Consolas, Microsoft YaHei UI"
                                                           TextTrimming="CharacterEllipsis"
                                                           Foreground="{DynamicResource Brush.TextDim}"
                                                           Text="{Binding Address}" />
                                            </StackPanel>
                                        </Grid>
                                    </DataTemplate>
                                </ListBox.ItemTemplate>
                            </ListBox>

                            <TextBlock Text="还没有设备连接，去「设置 · 连接」添加">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock" BasedOn="{StaticResource ItemDesc}">
                                        <Setter Property="Visibility" Value="Collapsed" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding Devices.HasDevices}" Value="False">
                                                <Setter Property="Visibility" Value="Visible" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                        </Grid>
                    </Grid>

                    <!-- 设置分组（贴底）：设备与连接 / 画面与声音 / 常规 / 诊断 -->
                    <StackPanel Grid.Row="2" Margin="10,0,10,10">
                        <TextBlock x:Name="NavGroupTitle"
                                   FontSize="11"
                                   FontWeight="SemiBold"
                                   Margin="10,6,10,6"
                                   Foreground="{DynamicResource Brush.TextDim}"
                                   Text="设置" />
                        <RadioButton x:Name="NavDevice"
                                     GroupName="Nav"
                                     Style="{StaticResource NavItem}"
                                     IsChecked="True"
                                     Checked="OnNavChanged"
                                     Tag="0"
                                     AutomationProperties.Name="设备与连接">
                            <StackPanel Orientation="Horizontal">
                                <Path Width="17"
                                      Height="17"
                                      Margin="0,0,10,0"
                                      Stretch="Uniform"
                                      Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=RadioButton}}"
                                      StrokeThickness="1.6"
                                      StrokeLineJoin="Round"
                                      Data="M7,3 H17 A2,2 0 0 1 19,5 V19 A2,2 0 0 1 17,21 H7 A2,2 0 0 1 5,19 V5 A2,2 0 0 1 7,3 Z M10,18 H14" />
                                <TextBlock x:Name="NavDeviceText" VerticalAlignment="Center" Text="设备与连接" />
                            </StackPanel>
                        </RadioButton>
                        <RadioButton x:Name="NavScreen"
                                     GroupName="Nav"
                                     Style="{StaticResource NavItem}"
                                     Checked="OnNavChanged"
                                     Tag="1"
                                     AutomationProperties.Name="画面与声音">
                            <StackPanel Orientation="Horizontal">
                                <Path Width="17"
                                      Height="17"
                                      Margin="0,0,10,0"
                                      Stretch="Uniform"
                                      Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=RadioButton}}"
                                      StrokeThickness="1.6"
                                      StrokeLineJoin="Round"
                                      Data="M3,4 H21 V16 H3 Z M8,20 H16 M12,16 V20" />
                                <TextBlock x:Name="NavScreenText" VerticalAlignment="Center" Text="画面与声音" />
                            </StackPanel>
                        </RadioButton>
                        <RadioButton x:Name="NavGeneral"
                                     GroupName="Nav"
                                     Style="{StaticResource NavItem}"
                                     Checked="OnNavChanged"
                                     Tag="2"
                                     AutomationProperties.Name="常规">
                            <StackPanel Orientation="Horizontal">
                                <Path Width="17"
                                      Height="17"
                                      Margin="0,0,10,0"
                                      Stretch="Uniform"
                                      Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=RadioButton}}"
                                      StrokeThickness="1.6"
                                      StrokeLineJoin="Round"
                                      Data="M4,7 H20 M4,12 H20 M4,17 H20 M9,7 m-2,0 a2,2 0 1,0 4,0 a2,2 0 1,0 -4,0 M15,17 m-2,0 a2,2 0 1,0 4,0 a2,2 0 1,0 -4,0" />
                                <TextBlock x:Name="NavGeneralText" VerticalAlignment="Center" Text="常规" />
                            </StackPanel>
                        </RadioButton>
                        <RadioButton x:Name="NavDiag"
                                     GroupName="Nav"
                                     Style="{StaticResource NavItem}"
                                     Checked="OnNavChanged"
                                     Tag="3"
                                     AutomationProperties.Name="诊断">
                            <StackPanel Orientation="Horizontal">
                                <Path Width="17"
                                      Height="17"
                                      Margin="0,0,10,0"
                                      Stretch="Uniform"
                                      Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=RadioButton}}"
                                      StrokeThickness="1.6"
                                      StrokeLineJoin="Round"
                                      Data="M2,12 H6 L9,4 L13,20 L16,12 H22" />
                                <TextBlock x:Name="NavDiagText" VerticalAlignment="Center" Text="诊断" />
                            </StackPanel>
                        </RadioButton>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- 内容区：设置页与设备主页二选一（侧边栏切换） -->
        <Grid Grid.Row="1" Grid.Column="1">
            <views:SettingsView x:Name="SettingsPage" />
            <views:DeviceHomeView x:Name="HomePage" Visibility="Collapsed" />

            <!--
              上下边缘的渐变遮罩：内容滚到标题栏下方 / 窗口底边时是柔和淡出，
              而不是一条硬邦邦的切线。不吃鼠标事件。
            -->
            <Border Height="18"
                    VerticalAlignment="Top"
                    IsHitTestVisible="False"
                    Background="{DynamicResource Brush.FadeTop}" />
            <Border Height="14"
                    VerticalAlignment="Bottom"
                    IsHitTestVisible="False"
                    Background="{DynamicResource Brush.FadeBottom}" />
        </Grid>

        <!--
          自绘 Toast：非阻塞的临时提示（保存报告 / 导出日志成功，或某个不打断流程的失败）。
          比系统 MessageBox 更轻、配色跟主题走，也不会抢焦点。默认隐藏、不吃鼠标事件。
        -->
        <Border x:Name="ToastBar"
                Grid.Row="0"
                Grid.RowSpan="2"
                Grid.Column="0"
                Grid.ColumnSpan="2"
                Panel.ZIndex="100"
                HorizontalAlignment="Center"
                VerticalAlignment="Bottom"
                Margin="0,0,0,30"
                Padding="16,10"
                CornerRadius="{DynamicResource Radius}"
                Background="{DynamicResource Brush.BgElev}"
                BorderBrush="{DynamicResource Brush.BorderStrong}"
                BorderThickness="1"
                Opacity="0"
                Visibility="Collapsed"
                IsHitTestVisible="False">
            <TextBlock x:Name="ToastText"
                       FontSize="13"
                       TextWrapping="Wrap"
                       MaxWidth="520"
                       Foreground="{DynamicResource Brush.Text}" />
        </Border>
    </Grid>
</Window>
