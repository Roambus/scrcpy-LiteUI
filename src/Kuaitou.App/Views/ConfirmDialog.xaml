<Window x:Class="Kuaitou.App.Views.ConfirmDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="确认"
        Width="380"
        SizeToContent="Height"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ShowInTaskbar="False"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        FontFamily="Microsoft YaHei UI, Segoe UI"
        FontSize="14">

    <!--
      自绘确认弹窗（不用系统 MessageBox）：保持主题统一，也方便以后加动效。
      破坏性操作（断开设备 / 删除分辨率预设）用它保留二次确认。
    -->
    <Border Background="{DynamicResource Brush.Card}"
            BorderBrush="{DynamicResource Brush.Border}"
            BorderThickness="1"
            CornerRadius="{DynamicResource Radius}"
            Padding="20"
            Margin="16">
        <StackPanel>
            <TextBlock x:Name="TitleText"
                       FontSize="15"
                       FontWeight="SemiBold"
                       TextWrapping="Wrap"
                       Foreground="{DynamicResource Brush.Text}" />
            <TextBlock x:Name="DescText"
                       Margin="0,10,0,0"
                       FontSize="13"
                       LineHeight="20"
                       TextWrapping="Wrap"
                       Foreground="{DynamicResource Brush.TextDim}" />
            <StackPanel Orientation="Horizontal"
                        HorizontalAlignment="Right"
                        Margin="0,20,0,0">
                <Button x:Name="CancelButton"
                        Style="{StaticResource Btn}"
                        MinWidth="84"
                        Margin="0,0,8,0"
                        Click="OnCancel"
                        Content="取消" />
                <Button x:Name="OkButton"
                        Style="{StaticResource BtnPrimary}"
                        MinWidth="84"
                        Click="OnOk" />
            </StackPanel>
        </StackPanel>
    </Border>
</Window>
